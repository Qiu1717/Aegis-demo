# AI智能助手系统 环境变量配置示例
# 复制为 .env 后填写真实值（不要把 .env 提交到代码仓库）

# ─────────────────────────────────────────────────────────
# 一、免费大模型（任选其一即可，全都免费）
# 系统会按 config.json 里的 provider_chain 顺序依次尝试，
# 第一个配了 Key 且能连通的服务商生效；全部失败则降级到离线兜底引擎。
# ─────────────────────────────────────────────────────────

# 1. 智谱 GLM（推荐：GLM-4-Flash 官方标注永久免费、不限 Token、并发 30）
#    申请地址：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# 2. 魔搭 ModelScope（每天 2000 次总额度，可跑 Qwen3.5 等模型）
#    申请地址：https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=

# 3. 硅基流动 SiliconFlow（多款永久免费模型）
#    申请地址：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# 4. 阿里云百炼（付费，已默认关闭；只有 config.json 里启用 dashscope 时才生效）
DASHSCOPE_API_KEY=

# ─────────────────────────────────────────────────────────
# 二、自定义 OpenAI 兼容端点（可选，优先级最高）
# 同时设置 LLM_BASE_URL 与 LLM_API_KEY 时，会自动插到调用链最前面。
# 适用于自建 vLLM / Ollama / 公司内网网关等场景。
# ─────────────────────────────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ─────────────────────────────────────────────────────────
# 三、数据库（Docker Compose 部署时已内置，本地开发可覆盖）
# ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=aiagent
